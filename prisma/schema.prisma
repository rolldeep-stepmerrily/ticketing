generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma/client"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        Int       @id @default(autoincrement())
  email     String    @unique
  name      String
  password  String
  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt
  deletedAt DateTime?

  tickets       Ticket[]
  refreshTokens RefreshToken[]

  @@map("users")
}

model RefreshToken {
  id        Int      @id @default(autoincrement())
  userId    Int
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@map("refresh_tokens")
}

model Concert {
  id          Int       @id @default(autoincrement())
  title       String
  description String?
  venue       String
  startsAt    DateTime
  endsAt      DateTime
  createdAt   DateTime  @default(now())
  updatedAt   DateTime? @updatedAt
  deletedAt   DateTime?

  seats Seat[]

  @@map("concerts")
}

model Seat {
  id        Int        @id @default(autoincrement())
  concertId Int
  row       String
  number    Int
  grade     SeatGrade
  price     Int
  status    SeatStatus @default(AVAILABLE)
  createdAt DateTime   @default(now())
  updatedAt DateTime?  @updatedAt

  concert Concert @relation(fields: [concertId], references: [id])
  ticket  Ticket?

  @@unique([concertId, row, number])
  @@map("seats")
}

model Ticket {
  id        Int          @id @default(autoincrement())
  userId    Int
  seatId    Int          @unique
  status    TicketStatus @default(PENDING)
  createdAt DateTime     @default(now())
  updatedAt DateTime?    @updatedAt

  user User @relation(fields: [userId], references: [id])
  seat Seat @relation(fields: [seatId], references: [id])

  @@map("tickets")
}

model OutboxEvent {
  id          Int       @id @default(autoincrement())
  eventId     String    @unique @default(uuid())
  aggregateId String
  eventType   String
  payload     Json
  publishedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([publishedAt])
  @@map("outbox_events")
}

model InboxEvent {
  id          String   @id
  eventType   String
  processedAt DateTime @default(now())

  @@index([eventType])
  @@map("inbox_events")
}

enum SeatGrade {
  VIP
  R
  S
  A
}

enum SeatStatus {
  AVAILABLE
  RESERVED
  SOLD
}

enum TicketStatus {
  PENDING
  CONFIRMED
  CANCELLED
}
